interface Estudiante {
  id:number, 
  nombre:string, 
  apellido:string,
  edad:number,
  curso:number,
  promedio:number,
  activo?:boolean,
  email?:string,
};

const estudiantes: Estudiante[] = [
{ id: 1, nombre: 'Jenaro', apellido: 'Avila', edad: 17, curso: 5 ,
promedio: 6 },
{ id: 2, nombre: 'Rodrigo', apellido: 'Muñoz', edad: 18, curso: 5,
promedio: 7, activo: true },
{ id: 3, nombre: 'Tizziano', apellido: 'Acuña', edad: 17, curso: 5,
promedio: 2, email: 'tizziano.bittar@gmail.com' },
];

function estaAprobado(e:Estudiante):boolean {
 return e.promedio >=6
}

function presentarEstudiante(e:Estudiante):string{
const estado = estaAprobado(e) ? `Aprobado` : `Desaprobado`
return `[${e.id}] Apellido: ${e.apellido} | Nombre: ${e.nombre} | Curso: ${e.curso}to | Promedio: ${e.promedio} | Calificación: ${estado}`

}
function recorrerArray():string{
let contaprobados:number = 0
for(let i:number=0 ;i <= estudiantes.length;i++){

  console.log(`${presentarEstudiante(estudiantes[i])}`)

 if(estaAprobado(estudiantes[i])) {
  contaprobados++;
}else{
return `La cantidad de aprobados son: ${contaprobados}`
} 
}
console.log(`La cantidad de aprobados son: ${contaprobados}`)
}

