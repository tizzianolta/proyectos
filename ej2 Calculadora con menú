function ej2(): void {
let num1:number = Number(prompt("ingrese el primer número"));
let num2:number = Number(prompt("ingrese el segundo número"));
let opcion: string | null = prompt("Elegi una opcion");
let resultado:number = 0;
switch (opcion){
    case "1":
        console.log("Elegiste sumar");
        resultado = num1 + num2;
    break;
    case "2":
        console.log("Elegiste restar");
        resultado = num1 - num2;
    break;
    case "3":
    console.log("Elegiste multiplicar");
    resultado = num1 * num2;
    break;
    case "4":
    console.log("Elegiste Dividir");
    if(num2 ===  0){
      console.log("No se puede dividir entre 0");
    }else {
      resultado = num1 / num2;
    }
    break;
    default: 
    console.log("Opción invalida");
}
if(resultado>0){
console.log(`El resultado de la operación: ${resultado}`)
}else{
    return
}
}
ej2();
